# Copy to .env and fill in real values. Never commit .env itself.

# Required — the only model this project calls.
OPENAI_API_KEY=''

# Optional — Neatlogs agent tracing (hackathon sponsor tool).
#
# Use the HTTP *ingest* key (Settings -> API Keys -> "HTTP ingest key",
# prefixed `nlw_`), NOT the project API key — the project key is rejected by
# the ingestion endpoint. The published `neatlogs` PyPI SDK is not used: it
# POSTs to app.neatlogs.com/api/data/v2, which returns 404. We post to the
# documented HTTP ingestion API instead.
#
# Tracing is OFF unless NEATLOGS_TRACE=1. NEATLOGS_PROJECT must match the
# project name exactly as it appears in the dashboard.
NEATLOGS_INGEST_KEY=''
NEATLOGS_PROJECT=''
NEATLOGS_TRACE='0'

# Optional — smallest.ai voice credits. Not used by the current domains.
SMALLEST_API_KEY=''

AGENT_FORGE_MODEL='gpt-5-nano'
